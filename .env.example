PORT=3000
CATALOGO_URL=http://127.0.0.1:3004
# Endpoints opcionais para consumidores externos de EQUIPE_FORMADA.
PROJETOS_EVENTOS_URL=
FINANCEIRO_EVENTOS_URL=
HOST=127.0.0.1
DATABASE_URL=postgres://cinebridge:cinebridge@localhost:5433/cinebridge
# Usado apenas por npm run test:postgres (banco separado).
TEST_DATABASE_URL=postgres://cinebridge:cinebridge@localhost:5433/cinebridge_test
# Sem SMTP, os e-mails ficam registrados para consulta pela API.
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM=cinebridge@localhost

# Atividade 3: provedores externos (Adapter) e decoradores do recomendador (Decorator).
# Armazenamento: local (disco), s3 ou gcs. Pagamento: stripe, pagseguro ou paypal.
# Profissionais: interno, linkedin ou indeed. S3, GCS, gateways e redes sociais são simulados.
ARMAZENAMENTO_PROVEDOR=local
ARMAZENAMENTO_LOCAL_DIR=.armazenamento
PAGAMENTO_PROVEDOR=stripe
PROFISSIONAIS_PROVEDOR=interno
# Ordem de aplicação, de dentro para fora. Vazio desliga os decoradores.
RECOMENDACAO_DECORADORES=cache,auditoria
