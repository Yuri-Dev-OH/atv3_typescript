@startuml
title Cinebridge - implementação (atividades 1, 2 e 3)
interface RepositorioProfissionais
interface Repositorio
interface ProcessadorEventos
interface PublicadorIntegracao
Repositorio --|> RepositorioProfissionais
class SistemaRecomendacao {
  -adaptadorArmazenamento: AdaptadorArmazenamento
  -adaptadorPagamento: AdaptadorPagamento
  -adaptadorProfissional: AdaptadorProfissional
  -estrategiaAtual: RecomendacaoStrategy
  +executarRecomendacao(projeto: Projeto): Promise<Equipe>
  +definirEstrategia(estrategia: RecomendacaoStrategy): void
  +configurarAdaptadores(armazenamento, pagamento, profissional): void
}
interface RecomendacaoStrategy <<Strategy>> {
  +recomendar(projeto: ProjetoDados, profissionais: ProfissionalDados[]): Map<Papel, Candidato[]>
}
class CatalogoProfissionais
class CatalogoHttp
class RepositorioPostgres
class OrquestradorEquipe <<Template Method>>
class OrquestradorPadrao
class SimilaridadeCosseno
class FiltragemColaborativa
class RegrasOrcamento
class EventosEmMemoria <<EventEmitter>>
interface Observador
class ObservadorComposicao
class AuditoriaRecomendacao
class NotificadorInterno
class NotificadorEmail
class IntegracaoEquipe
class PublicadorHttp
class Profissional
interface Visitante <<Visitor>>
class ValidadorConsistencia
class CalculadorCompatibilidade
class GeradorRelatorio
RepositorioPostgres ..|> Repositorio
CatalogoHttp ..|> RepositorioProfissionais
SistemaRecomendacao --> Repositorio
SistemaRecomendacao --> ProcessadorEventos
SistemaRecomendacao --> CatalogoProfissionais
CatalogoProfissionais --> RepositorioProfissionais
SistemaRecomendacao --> OrquestradorEquipe
OrquestradorPadrao --|> OrquestradorEquipe
OrquestradorEquipe --> RecomendacaoStrategy
EventosEmMemoria ..|> ProcessadorEventos
EventosEmMemoria o--> Observador
ObservadorComposicao ..|> Observador
AuditoriaRecomendacao ..|> Observador
NotificadorInterno ..|> Observador
NotificadorEmail ..|> Observador
IntegracaoEquipe ..|> Observador
ObservadorComposicao --> SistemaRecomendacao : aplicarRespostaConvite
IntegracaoEquipe --> PublicadorIntegracao
PublicadorHttp ..|> PublicadorIntegracao
Profissional --> Visitante : aceitar
ValidadorConsistencia ..|> Visitante
CalculadorCompatibilidade ..|> Visitante
GeradorRelatorio ..|> Visitante
interface Prototipo<T> <<Prototype>> {
  +clonar(): T
}
abstract class "Projeto<R>" as Projeto {
  +tipo: TipoProjeto
  +restricoes: R
  +clonar(): Projeto<R>
  +ajustar(ajustes, restricoes): this
  +comEstado(estado, profissionais): Projeto<R>
}
Projeto --> Visitante : aceitar
class ProjetoFiccao
class ProjetoDocumentario
class ProjetoAnimacao
class ProjetoPublicitario
class RegistroPrototipos {
  -prototipos: Map<TipoProjeto, Projeto>
  +registrar(prototipo): this
  +obter(tipo): Projeto
  +criar(tipo, ajustes): Projeto
  +hidratar(estado, profissionais): Projeto
}
Projeto ..|> Prototipo
Profissional ..|> Prototipo
ProjetoFiccao --|> Projeto
ProjetoDocumentario --|> Projeto
ProjetoAnimacao --|> Projeto
ProjetoPublicitario --|> Projeto
RegistroPrototipos "1" o--> "0..*" Projeto : clona
SistemaRecomendacao --> RegistroPrototipos
interface FabricaProjeto <<Abstract Factory>> {
  +tipo: TipoProjeto
  +criarProjeto(dados): Projeto
  +criarValidador(): ValidadorProjeto
  +criarRecomendador(estrategia): RecomendacaoStrategy
  +criarNotificador(): NotificadorProjeto
  +criarRelatorio(): Visitante
}
class GeradorRelatorioAnimacao
GeradorRelatorioAnimacao --|> GeradorRelatorio
FabricaAnimacao ..> GeradorRelatorioAnimacao : cria
abstract class FabricaBase
class FabricaFiccao
class FabricaDocumentario
class FabricaAnimacao
class FabricaPublicitario
interface ValidadorProjeto
interface NotificadorProjeto
class RecomendadorPriorizado
FabricaBase ..|> FabricaProjeto
FabricaFiccao --|> FabricaBase
FabricaDocumentario --|> FabricaBase
FabricaAnimacao --|> FabricaBase
FabricaPublicitario --|> FabricaBase
FabricaBase --> Projeto : prototipo
Projeto ..> FabricaProjeto : criarFabrica() <<Factory Method>>
FabricaProjeto ..> ValidadorProjeto : cria
FabricaProjeto ..> NotificadorProjeto : cria
FabricaProjeto ..> RecomendacaoStrategy : cria
OrquestradorEquipe --> "1" FabricaProjeto
SistemaRecomendacao ..> FabricaProjeto : seleciona pelo tipo
note right of Profissional
preco: valor proposto
faixaPreco: mínimo e máximo
competências, avaliações,
disponibilidade e histórico
end note
note bottom of CatalogoHttp
HTTP para catálogo com PostgreSQL próprio.
Falha: cache recente ou equipe parcial.
end note
note bottom of PublicadorHttp
EQUIPE_FORMADA para projetos e financeiro.
Repetição com chave de idempotência.
end note
' ===== Atividade 3: Adapter =====
interface AdaptadorArmazenamento <<Adapter>> {
  +salvarArquivo(conteudo: Buffer, metadados: MetadadosArquivo): Promise<string>
  +recuperarArquivo(id: string): Promise<Buffer>
  +listarArquivos(prefixo: string): Promise<string[]>
}
interface AdaptadorPagamento <<Adapter>> {
  +efetuarPagamento(valor: number, origem: string, destino: string): Promise<string>
  +cancelarPagamento(id: string): Promise<boolean>
  +verificarPagamento(id: string): Promise<StatusPagamento>
}
interface AdaptadorProfissional <<Adapter>> {
  +listarProfissionais(criterios): Promise<Profissional[]>
  +detalharProfissional(id: string): Promise<Profissional>
  +registrarAvaliacao(id: string, avaliacao): Promise<void>
}
abstract class ArmazenamentoExterno {
  +upload(arquivo: File): Promise<string>
  +download(id: string): Promise<File>
  +listar(pasta: string): Promise<string[]>
}
abstract class GatewayPagamento {
  +processarPagamento(valor: number, dados): Promise<Transacao>
  +estornarPagamento(id: string): Promise<boolean>
  +consultarStatus(id: string): Promise<string>
}
abstract class ApiProfissionalExterna {
  +buscarProfissionais(filtros): Promise<unknown[]>
  +obterPerfil(id: string): Promise<unknown>
  +avaliarProfissional(id: string, nota: number): Promise<void>
}
class AdaptadorS3
class AdaptadorGoogleCloud
class AdaptadorLocal
class AdaptadorStripe
class AdaptadorPagSeguro
class AdaptadorPayPal
class AdaptadorLinkedIn
class AdaptadorIndeed
class AdaptadorInterno
class S3Simulado
class GoogleCloudStorageSimulado
class StripeSimulado
class PagSeguroSimulado
class PayPalSimulado
class LinkedInSimulado
class IndeedSimulado
SistemaRecomendacao --> "1" AdaptadorArmazenamento : utiliza
SistemaRecomendacao --> "1" AdaptadorPagamento : utiliza
SistemaRecomendacao --> "1" AdaptadorProfissional : utiliza
AdaptadorS3 ..|> AdaptadorArmazenamento
AdaptadorGoogleCloud ..|> AdaptadorArmazenamento
AdaptadorLocal ..|> AdaptadorArmazenamento
AdaptadorStripe ..|> AdaptadorPagamento
AdaptadorPagSeguro ..|> AdaptadorPagamento
AdaptadorPayPal ..|> AdaptadorPagamento
AdaptadorLinkedIn ..|> AdaptadorProfissional
AdaptadorIndeed ..|> AdaptadorProfissional
AdaptadorInterno ..|> AdaptadorProfissional
S3Simulado --|> ArmazenamentoExterno
GoogleCloudStorageSimulado --|> ArmazenamentoExterno
StripeSimulado --|> GatewayPagamento
PagSeguroSimulado --|> GatewayPagamento
PayPalSimulado --|> GatewayPagamento
LinkedInSimulado --|> ApiProfissionalExterna
IndeedSimulado --|> ApiProfissionalExterna
AdaptadorS3 "1" --> "0..1" S3Simulado : adapta
AdaptadorGoogleCloud "1" --> "0..1" GoogleCloudStorageSimulado : adapta
AdaptadorStripe "1" --> "0..1" StripeSimulado : adapta
AdaptadorPagSeguro "1" --> "0..1" PagSeguroSimulado : adapta
AdaptadorPayPal "1" --> "0..1" PayPalSimulado : adapta
AdaptadorLinkedIn "1" --> "0..1" LinkedInSimulado : adapta
AdaptadorIndeed "1" --> "0..1" IndeedSimulado : adapta
AdaptadorInterno --> RepositorioProfissionais : adapta
note bottom of AdaptadorLocal
node:fs no diretório ARMAZENAMENTO_LOCAL_DIR;
identificadores lógicos validados contra path traversal.
end note
' ===== Atividade 3: Composite =====
interface ServicoProjeto <<Composite>> {
  +calcularCusto(): number
  +listarSubservicos(): ServicoProjeto[]
  +obterPrazo(): number
  +validar(): string[]
  +papeisExigidos(): PapelExigido[]
  +avaliarCobertura(cobertos): boolean
}
class ServicoAtomico {
  +papel: Papel
  -custo: number
  -prazo: number
}
class PacoteServico {
  -itens: ServicoProjeto[]
  +paralelo: boolean
  +adicionar(servico): this
  +remover(servico): boolean
}
ServicoAtomico ..|> ServicoProjeto
PacoteServico ..|> ServicoProjeto
PacoteServico "1" o--> "1..*" ServicoProjeto : itens
Projeto --> "1" ServicoProjeto : servicoPrincipal
note right of Projeto
calcularCustoTotal() delega a servicoPrincipal.calcularCusto();
validarEstrutura() é recursiva (papéis e prazos na janela).
end note
FabricaProjeto ..> ServicoProjeto : criarServicoPrincipal()
' ===== Atividade 3: Decorator =====
abstract class RecomendadorBase <<Template Method>>
abstract class DecoradorRecomendacao <<Decorator>> {
  #interno: RecomendacaoStrategy
}
class CacheDecorator
class AuditoriaDecorator
class CompressaoDecorator
class MontadorPilhaRecomendacao {
  +politica: NomeDecorador[]
  +montar(base, preferencia?): RecomendacaoStrategy
  +definirPolitica(politica): void
}
class ArmazemCacheRecomendacao
class RegistroAuditoriaRecomendacao
class MedidorCompressao
RecomendadorBase ..|> RecomendacaoStrategy
SimilaridadeCosseno --|> RecomendadorBase
FiltragemColaborativa --|> RecomendadorBase
RegrasOrcamento --|> RecomendadorBase
DecoradorRecomendacao ..|> RecomendacaoStrategy
DecoradorRecomendacao --> "1" RecomendacaoStrategy : interno
CacheDecorator --|> DecoradorRecomendacao
AuditoriaDecorator --|> DecoradorRecomendacao
CompressaoDecorator --|> DecoradorRecomendacao
RecomendadorPriorizado --|> DecoradorRecomendacao
CacheDecorator --> ArmazemCacheRecomendacao
AuditoriaDecorator --> RegistroAuditoriaRecomendacao
CompressaoDecorator --> MedidorCompressao
MontadorPilhaRecomendacao ..> DecoradorRecomendacao : cria
SistemaRecomendacao --> "1" MontadorPilhaRecomendacao
note bottom of MontadorPilhaRecomendacao
Ordem de aplicação de dentro para fora.
Política: RECOMENDACAO_DECORADORES ou PUT /recomendador/decoradores;
preferência do produtor: ProjetoDados.decoradores.
end note
@enduml
